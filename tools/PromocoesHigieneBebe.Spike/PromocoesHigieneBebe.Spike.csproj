<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fase 0 (T001–T003): programa descartável para validar a coleta nas drogarias. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <RootNamespace>PromocoesHigieneBebe.Spike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versão flutuante só no spike; o projeto definitivo fixa versões em Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Playwright" Version="1.*" />
  </ItemGroup>

</Project>
